# Copier ce fichier en .env.docker et compléter les valeurs
# Base de données MySQL
DB_HOST=db
DB_PORT=3306
DB_NAME=vite_et_gourmand
DB_USER=vg_user
DB_PASSWORD=

# MongoDB
MONGO_URI=mongodb+srv://<Utilisateur>:<mot de passe>@<adresse de la base>.mongodb.net/
MONGO_DB=vite_et_gourmand


# Application
APP_ENV=development
APP_SECRET=
APP_URL=http://localhost:8080

# Gestion mails - Mailtrap
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

#MariaDB
MARIADB_DATABASE=vite_et_gourmand
MARIADB_USER=vg_user
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
