# Base de données MySQL
DB_HOST=localhost
# 3306 si MySql standard / 3307 pour xampp
DB_PORT=3307 
DB_NAME=vite_et_gourmand
DB_USER=root
DB_PASSWORD=

# MongoDB
#Indiquer votre nom d'utilisateur créé par mongodb pour accès à la base et votre mot de passe dans les crochets (<> à retirer)
MONGO_URI=mongodb+srv://<Utilisateur>:<mot de passe>@<adresse de la base>.mongodb.net/
MONGO_DB=vite_et_gourmand

# Application
APP_ENV=development
APP_SECRET=changeme

# Mail : Gestion par Mailtrap, identifiants à récupérer sur mailtrap.io
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=